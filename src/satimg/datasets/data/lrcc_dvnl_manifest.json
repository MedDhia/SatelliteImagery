  "products": {
    "lrcc-dvnl": {
      "title": "LRCC-DVNL annual nighttime lights (1992-2022)",
      "description": "Headline product: DMSP-like annual NTL composites, continuity- and trend-calibrated across the DMSP/OLS and VIIRS eras. One GeoTIFF per year, DN 0-63, nodata 127.",
      "file_format": "GeoTIFF",
      "filename_pattern": "LACC_{year}.tif",
      "years": [
        1992,
        1993,
        1994,
        1995,
        1996,
        1997,
        1998,
